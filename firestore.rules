rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MonoNote Standard Security Rules
    // Deployment Trigger: 2024-05-22T14:30:00Z - Updated list permissions

    match /notes/{noteId} {
      // Allow the owner to read (get and list) their own notes
      // List operations are allowed if the query filters by userId
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Users can only create notes where they are the owner
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Users can only update or delete their own notes
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
