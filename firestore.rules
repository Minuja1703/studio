rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MonoNote Gallery Archive Security Rules
    // Deployment Trigger: 2024-05-21T15:20:00Z - Explicit list/get authorization

    match /notes/{noteId} {
      // Allow read (get and list) if the authenticated user is the owner.
      // For listing (queries), the query MUST filter by userId == request.auth.uid.
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Allow creation only if the authenticated user sets themselves as the owner.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Allow update and delete only for the owner.
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}