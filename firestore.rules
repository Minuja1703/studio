rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MonoNote Standard Security Rules
    // Deployment Trigger: 2024-05-22T10:00:00Z

    match /notes/{noteId} {
      // Users can only read, update, or delete their own notes
      // The 'read' rule covers both 'get' and 'list'
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Users can only create notes where they are the owner
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}