rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MonoNote Simple Security Rules
    // Deployment Trigger: 2024-05-21T16:45:00Z - Standardized read/write authorization

    match /notes/{noteId} {
      // Allow read (get and list) if the authenticated user is the owner.
      // This rule requires the query to filter by userId == request.auth.uid.
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      
      // Allow creation if the authenticated user sets themselves as the owner.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Allow update and delete only for the owner.
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}